{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "caldav": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--no-project", "--python", ">=3.11", "${PLUGIN_ROOT}/hermes/launch.py"],
      "env": {
        "CALDAV_MCP_CONFIG": "${CALDAV_MCP_CONFIG}",
        "CALDAV_MCP_BINARY": "${CALDAV_MCP_BINARY}",
        "CALDAV_MCP_CREDENTIALS": "${CALDAV_MCP_CREDENTIALS}"
      }
    }
  }
}
