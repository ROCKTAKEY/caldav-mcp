{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "caldav": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--python",
        ">=3.11",
        "--locked",
        "${PLUGIN_ROOT}/plugin/launch.py"
      ]
    }
  }
}
